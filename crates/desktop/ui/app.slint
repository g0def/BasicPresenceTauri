// Root of the BasicPresence UI. Rust drives it through the `AppState` global
// (state in, user intents out as callbacks); screens stay presentational.

import "../assets/fonts/JetBrainsMono-Regular.ttf";
import "../assets/fonts/JetBrainsMono-SemiBold.ttf";
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { LoginScreen } from "screens/login.slint";
import { MainShell } from "screens/main-shell.slint";
import { StartupErrorScreen } from "screens/startup-error.slint";

export { Theme }
export { AppState, AuthState, ProfileState, PresenceState, Screen, Page, ProfileItem, SecurityEventItem, DayCell, CommuteChoice, ModeOption, SegmentDraft } from "state.slint";
import { AppState, AuthState, Screen } from "state.slint";

export component AppWindow inherits Window {
    title: "Basic Presence";
    icon: @image-url("../assets/icons/icon-512.png");
    preferred-width: 1100px;
    preferred-height: 800px;
    min-width: 420px;
    min-height: 560px;
    background: Theme.background;
    default-font-size: Theme.text-sm;

    // Follow the OS color scheme at startup, then pin the std widgets' scheme
    // to `Theme.dark` (otherwise they could switch alone when the OS reports
    // its scheme late, and render dark widgets on a light page).
    init => {
        Theme.dark = Palette.color-scheme == ColorScheme.dark;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }

    if AppState.screen == Screen.login: LoginScreen {
        register-mode: !AuthState.account-exists;
        busy: AuthState.busy;
        error: AppState.error-text(AuthState.error-code, AuthState.error-arg);
        lang: AppState.lang;
        submit(user, password) => {
            if (AuthState.account-exists) {
                AuthState.login(user, password);
            } else {
                AuthState.register(user, password);
            }
        }
        edited => {
            AuthState.error-code = "";
            AuthState.error-arg = "";
        }
        toggle-theme => { Theme.dark = !Theme.dark; }
        set-lang(lang) => { AppState.set-lang(lang); }
    }

    if AppState.screen == Screen.main: MainShell { }

    if AppState.screen == Screen.startup-error: StartupErrorScreen {
        reason: AppState.startup-text(AppState.startup-reason);
        detail: AppState.startup-detail;
        quit => { AppState.quit(); }
    }
}
