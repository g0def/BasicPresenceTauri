import { Theme } from "../theme.slint";

// One entry of a popup menu.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> checkable;
    in property <bool> destructive;
    callback activated();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.accent : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            width: 14px;
            text: root.checked ? "✓" : "";
            vertical-alignment: center;
            color: Theme.primary;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.text-sm;
            color: root.destructive ? Theme.destructive : (touch.has-hover ? Theme.accent-foreground : Theme.popover-foreground);
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// Section label inside a popup menu.
export component MenuLabel inherits Text {
    font-size: Theme.text-xs;
    font-weight: 600;
    color: Theme.muted-foreground;
    height: 26px;
    vertical-alignment: center;
    x: 8px;
}

export component MenuSeparator inherits Rectangle {
    height: 1px;
    background: Theme.border;
}
