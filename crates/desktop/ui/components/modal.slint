import { Theme } from "../theme.slint";

// Modal dialog: dims the page, centers a card, closes on Escape or a click
// on the backdrop (unless `dismissable` is false). Place it last in the
// window so it draws above everything.
export component Modal inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <length> card-width: 440px;
    in property <bool> dismissable: true;
    callback close();

    background: Theme.dark ? #000000a0 : #00000066;

    // Swallow clicks on the backdrop (nothing below must react).
    TouchArea {
        clicked => {
            if (root.dismissable) { root.close(); }
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && root.dismissable) {
                root.close();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 2);
            width: min(root.card-width, root.width - 32px);
            height: self.preferred-height;
            background: Theme.popover;
            border-radius: Theme.radius-xl;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            accessible-role: groupbox;
            accessible-label: root.title;

            // Clicks inside the card do not reach the backdrop.
            TouchArea { }

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: root.title;
                    font-size: Theme.text-lg;
                    font-weight: 600;
                    color: Theme.popover-foreground;
                    wrap: word-wrap;
                }
                if root.description != "": Text {
                    text: root.description;
                    font-size: Theme.text-sm;
                    color: Theme.muted-foreground;
                    wrap: word-wrap;
                }
                @children
            }
        }
    }
}
