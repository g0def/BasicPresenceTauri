{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "basic-presence",
  "version": "0.1.1",
  "identifier": "com.godef.basic-presence",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "basic-presence",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMEI2OEY2NDI2QkExNkIKUldScm9XdEM5bWdMNjRmS01QRklwdzhsL053N3VSOUVVdVBTYURiZlF0QWtJK0ZlcnVyVC9ZbFoK",
      "endpoints": [
        "https://github.com/g0def/BasicPresenceTauri/releases/latest/download/latest.json"
      ]
    }
  }
}
